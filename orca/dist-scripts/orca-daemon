#!/bin/sh
# Runs the Orca daemon. Needs Java 21+ and, on this machine, Codex and/or TRAE CLI installed and logged in.
#   orca-daemon register --server https://orca.example.com --code orca_r_...
#   orca-daemon start
#   orca-daemon probe
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="${ORCA_DAEMON_JAR:-$DIR/orca-daemon.jar}"
if ! command -v java >/dev/null 2>&1; then
  echo "Java 21 or newer is required (https://adoptium.net)" >&2
  exit 1
fi
exec java ${ORCA_DAEMON_JAVA_OPTS:-} -jar "$JAR" "$@"
