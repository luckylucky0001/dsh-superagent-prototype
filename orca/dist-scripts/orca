#!/bin/sh
# The orca command-line client. Needs Java 21+.
#   orca login --server https://orca.example.com --token orca_p_...   (Settings > API tokens)
#   orca issues · orca ask Codex "..." · orca run "Codex review" --wait · orca --help
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="${ORCA_CLI_JAR:-$DIR/orca-cli.jar}"
if ! command -v java >/dev/null 2>&1; then
  echo "Java 21 or newer is required" >&2
  exit 1
fi
exec java ${ORCA_CLI_JAVA_OPTS:-} -jar "$JAR" "$@"
