<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.orca</groupId>
  <artifactId>orca-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Orca</name>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <description>Agents-as-teammates platform with composable workflows, driving Codex and TRAE CLI.</description>

  <modules>
    <module>orca-workflow</module>
    <module>orca-protocol</module>
    <module>orca-agent</module>
    <module>orca-daemon</module>
    <module>orca-cli</module>
    <module>orca-server</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.1.3</spring-boot.version>
    <orca.excludedGroups>live</orca.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.orca</groupId>
        <artifactId>orca-workflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.orca</groupId>
        <artifactId>orca-protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.orca</groupId>
        <artifactId>orca-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.orca</groupId>
        <artifactId>orca-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.orca</groupId>
        <artifactId>orca-agent</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>${orca.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
