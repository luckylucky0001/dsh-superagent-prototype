ORCA_DB_PASSWORD=change-me-db
ORCA_ADMIN_EMAIL=admin@example.com
ORCA_ADMIN_PASSWORD=change-me-admin
# The URL people and daemons use to reach the server (put TLS in front of it in production).
ORCA_PUBLIC_URL=https://orca.example.com
ORCA_TIMEZONE=Asia/Singapore
# Comma separated hosts that http.request nodes may call, e.g. api.github.com
ORCA_HTTP_ALLOWED_HOSTS=
ORCA_HTTP_PORT=8080
