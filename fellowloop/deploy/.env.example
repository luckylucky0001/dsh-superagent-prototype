FELLOWLOOP_DB_PASSWORD=change-me-db
FELLOWLOOP_ADMIN_EMAIL=admin@example.com
FELLOWLOOP_ADMIN_PASSWORD=change-me-admin
# The URL people and daemons use to reach the server (put TLS in front of it in production).
FELLOWLOOP_PUBLIC_URL=https://fellowloop.example.com
FELLOWLOOP_TIMEZONE=Asia/Singapore
# Comma separated hosts that http.request nodes may call, e.g. api.github.com
FELLOWLOOP_HTTP_ALLOWED_HOSTS=
FELLOWLOOP_HTTP_PORT=8080
# Optional: post new inbox items to a team chat webhook; format feishu|dingtalk|wecom|slack|teams
FELLOWLOOP_NOTIFY_WEBHOOK_URL=
FELLOWLOOP_NOTIFY_FORMAT=feishu
