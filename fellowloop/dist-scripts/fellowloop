#!/bin/sh
# The fellowloop command-line client. Needs Java 21+.
#   fellowloop login --server https://fellowloop.example.com --token fellowloop_p_...   (Settings > API tokens)
#   fellowloop issues · fellowloop ask Codex "..." · fellowloop run "Codex review" --wait · fellowloop --help
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="${FELLOWLOOP_CLI_JAR:-$DIR/fellowloop-cli.jar}"
if ! command -v java >/dev/null 2>&1; then
  echo "Java 21 or newer is required" >&2
  exit 1
fi
exec java ${FELLOWLOOP_CLI_JAVA_OPTS:-} -jar "$JAR" "$@"
